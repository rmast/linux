+		 */
+		ret = mt9m114_group_hold(sensor, true);
+		if (ret)
+			break;
+
+		cci_write(sensor->regmap, MT9M114_COARSE_INTEGRATION_TIME,
+			  ctrl->val, &ret);
 		cci_write(sensor->regmap,
 			  MT9M114_CAM_SENSOR_CONTROL_COARSE_INTEGRATION_TIME,
 			  ctrl->val, &ret);
+
+		mt9m114_group_hold(sensor, false);
 		break;
 
 	case V4L2_CID_ANALOGUE_GAIN:
+		/*
+		 * Ensure manual mode for gain control as well.
+		 * The sensor's internal AE will fight our gain settings otherwise.
+		 */
+		ret = mt9m114_ensure_manual_ae(sensor);
+		if (ret)
+			break;
+
 		/*
 		 * The CAM_SENSOR_CONTROL_ANALOG_GAIN contains linear analog
 		 * gain values that are mapped to the GLOBAL_GAIN register
@@ -1120,6 +1448,43 @@ static int mt9m114_pa_s_ctrl(struct v4l2_ctrl *ctrl)
 				      mask, ctrl->val ? mask : 0, NULL);
 		break;
 
+	case V4L2_CID_MT9M114_AE_METERING_PRESET:
+		/*
+		 * Apply a preset metering pattern to the 5x5 grid.
+		 * This is much more user-friendly than exposing 25 individual controls.
+		 *
+		 * Preset 0 = Center-weighted (default)
+		 * Preset 1 = Uniform
+		 * Preset 2 = Backlit portrait
