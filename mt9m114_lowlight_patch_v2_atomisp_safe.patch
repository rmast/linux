+	0x00, 0x02, 0x04, 0x02, 0x00,
+	0x00, 0x04, 0x0f, 0x04, 0x00,  /* Only center matters */
+	0x00, 0x02, 0x04, 0x02, 0x00,
+	0x00, 0x00, 0x00, 0x00, 0x00
