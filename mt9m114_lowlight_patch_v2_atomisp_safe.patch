+/*
+ * mt9m114_group_hold - Enable/disable shadow register group hold
+ *
+ * This is CRITICAL for preventing the "rolling shutter" bug when updating
+ * multiple registers (VTS + Exposure) that must be applied atomically.
+ *
+ * Without this, the sensor may apply VTS in frame N and Exposure in frame N+1,
+ * causing a black streak or exposure glitch.
+ *
+ * Register 0x8404 (GROUPED_PARAMETER_HOLD):
+ *   0x01 = Start group (shadow registers)
+ *   0x00 = End group (apply all at once on next frame)
+ */
+static int mt9m114_group_hold(struct mt9m114 *sensor, bool enable)
+{
+	int ret;
+
+	ret = cci_write(sensor->regmap, MT9M114_GROUPED_PARAMETER_HOLD,
+			enable ? MT9M114_GROUP_HOLD_START : MT9M114_GROUP_HOLD_END,
+			NULL);
+	if (ret) {
+		dev_err(&sensor->client->dev,
+			"Failed to %s group hold: %d\n",
+			enable ? "enable" : "disable", ret);
+	}
+
+	return ret;
+}
+
+/*
+ * mt9m114_ensure_manual_ae - Disable sensor's internal auto-exposure
+ *
+ * The MT9M114 has an internal auto-exposure engine (SOC firmware).
+ * When V4L2 manual controls (exposure, gain) are used, we MUST disable
+ * the sensor's internal AE, otherwise the hardware fights the software.
+ *
+ * Register 0xA800 (AE_TRACK_MODE):
+ *   BIT(0) = 1: Auto-exposure active (sensor controls exposure/gain)
+ *   BIT(0) = 0: Manual mode (V4L2 controls active)
+ *
+ * This was a major bug in early mainline versions - the sensor would
+ * ignore manual exposure commands because its internal AE was still active.
+ */
+static int mt9m114_ensure_manual_ae(struct mt9m114 *sensor)
+{
+	int ret;
+	u64 ae_mode;
+
+	/* Check current mode */
+	ret = cci_read(sensor->regmap, MT9M114_AE_TRACK_MODE, &ae_mode, NULL);
+	if (ret)
+		return ret;
+
+	/* If already manual, nothing to do */
+	if (!(ae_mode & MT9M114_AE_TRACK_MODE_AUTO))
+		return 0;
+
+	dev_dbg(&sensor->client->dev,
+		"Disabling sensor internal auto-exposure for manual control\n");
+
+	/* Disable internal AE */
+	ret = cci_write(sensor->regmap, MT9M114_AE_TRACK_MODE,
+			MT9M114_AE_TRACK_MODE_MANUAL, NULL);
+	if (ret) {
+		dev_err(&sensor->client->dev,
+			"Failed to disable internal AE: %d\n", ret);
+		return ret;
+	}
+
+	return 0;
+}
+
+/*
+ * mt9m114_update_vts_for_exposure - Adjust VTS to accommodate long exposures
+ *
+ * This function implements dynamic VTS adjustment for low-light scenarios.
+ * When the requested exposure time exceeds what's possible within the current
+ * frame interval, we increase the VTS (vertical blanking) to make room.
+ * This drops the frame rate but allows the sensor to gather more light.
+ *
+ * This is critical for the Bay Trail T100 low-light performance and matches
+ * the behavior found in the android-ia vendor kernel.
+ *
+ * IMPORTANT: This function uses GROUP_HOLD to ensure VTS and Exposure are
+ * applied atomically, preventing the "rolling shutter" bug.
+ */
+static int mt9m114_update_vts_for_exposure(struct mt9m114 *sensor,
+					    const struct v4l2_mbus_framefmt *format,
+					    u32 exposure)
+{
+	u32 current_vblank;
+	u32 min_frame_length;
+	u32 new_frame_length;
+	u32 new_vblank;
+	int ret;
+
+	/*
+	 * The coarse integration time (exposure) must be less than
+	 * frame_length_lines - 2 (sensor limitation).
+	 * If the requested exposure requires it, we extend the frame length.
+	 */
+	min_frame_length = exposure + 2;
+
+	if (min_frame_length <= format->height) {
+		/* Normal case: exposure fits within current frame */
+		return 0;
+	}
+
+	/*
+	 * Calculate required VTS. The frame_length_lines register value is
+	 * height + vblank, so we need to adjust vblank accordingly.
+	 */
+	new_frame_length = min_frame_length;
+	new_vblank = new_frame_length - format->height;
+
+	/* Clamp to hardware limits */
+	if (new_frame_length > MT9M114_CAM_SENSOR_CFG_FRAME_LENGTH_LINES_MAX)
+		new_vblank = MT9M114_MAX_VBLANK_LOWLIGHT;
+
+	/*
+	 * AtomISP WARNING: Dynamic framerate changes during streaming can
+	 * cause CSS firmware timeouts or frozen streams. Ideally, the ISP
+	 * pipeline should be restarted when VBLANK changes significantly.
+	 */
+	if (sensor->streaming && new_vblank > sensor->pa.vblank->val * 2) {
+		dev_warn_once(&sensor->client->dev,
+			      "Large VTS adjustment during streaming (vblank %u -> %u). "
+			      "AtomISP may require pipeline restart for stability.\n",
+			      sensor->pa.vblank->val, new_vblank);
+	}
+
+	dev_dbg(&sensor->client->dev,
+		"Long exposure %u requires VTS adjustment: vblank %u -> %u (FLL: %u)\n",
+		exposure, sensor->pa.vblank->val, new_vblank, new_frame_length);
+
+	/*
+	 * CRITICAL: Use GROUP_HOLD to apply VTS and exposure atomically.
+	 * This prevents the sensor from applying VTS in one frame and
+	 * exposure in the next, which causes black streaks (rolling shutter bug).
+	 */
+	ret = mt9m114_group_hold(sensor, true);
+	if (ret)
+		return ret;
+
+	/* Write to both direct sensor register and SOC register */
+	ret = cci_write(sensor->regmap, MT9M114_FRAME_LENGTH_LINES,
+			new_frame_length, NULL);
+	if (ret)
+		goto group_hold_end;
+
+	ret = cci_write(sensor->regmap,
+			MT9M114_CAM_SENSOR_CFG_FRAME_LENGTH_LINES,
+			new_frame_length, NULL);
+	if (ret)
+		goto group_hold_end;
+
+	/*
+	 * Update the vblank control to reflect the new value. This keeps
+	 * userspace in sync but doesn't trigger another s_ctrl callback.
+	 */
+	__v4l2_ctrl_s_ctrl(sensor->pa.vblank, new_vblank);
+
+group_hold_end:
+	/* Release group hold - changes apply on next frame */
+	mt9m114_group_hold(sensor, false);
+
+	return ret;
+}
+
 static int mt9m114_pa_s_ctrl(struct v4l2_ctrl *ctrl)
 {
 	struct mt9m114 *sensor = pa_ctrl_to_mt9m114(ctrl);
 	const struct v4l2_mbus_framefmt *format;
 	struct v4l2_subdev_state *state;
 	int ret = 0;
+	int i;
 	u64 mask;
+	const u8 *preset_pattern;
 
 	/* V4L2 controls values are applied only when power is up. */
 	if (!pm_runtime_get_if_in_use(&sensor->client->dev))
 		return 0;
 
 	state = v4l2_subdev_get_locked_active_state(&sensor->pa.sd);
 	format = v4l2_subdev_state_get_format(state, 0);
 
 	switch (ctrl->id) {
 	case V4L2_CID_HBLANK:
 		cci_write(sensor->regmap, MT9M114_CAM_SENSOR_CFG_LINE_LENGTH_PCK,
 			  ctrl->val + format->width, &ret);
 		break;
 
 	case V4L2_CID_VBLANK:
+		/*
+		 * Write to both the direct sensor register (0x300A) and the
+		 * CAM configuration register (0xC812) to ensure synchronization.
+		 *
+		 * AtomISP Note: Large VBLANK changes during streaming may cause
+		 * CSS firmware issues. Consider stopping/restarting the stream
+		 * if VBLANK changes by more than 2x.
+		 */
+		ret = mt9m114_group_hold(sensor, true);
+		if (ret)
+			break;
+
+		cci_write(sensor->regmap, MT9M114_FRAME_LENGTH_LINES,
+			  ctrl->val + format->height, &ret);
 		cci_write(sensor->regmap, MT9M114_CAM_SENSOR_CFG_FRAME_LENGTH_LINES,
 			  ctrl->val + format->height, &ret);
+
+		mt9m114_group_hold(sensor, false);
 		break;
 
 	case V4L2_CID_EXPOSURE:
+		/*
+		 * Ensure sensor's internal auto-exposure is disabled.
+		 * Without this, the sensor ignores our manual exposure commands.
+		 */
+		ret = mt9m114_ensure_manual_ae(sensor);
+		if (ret)
+			break;
+
+		/*
+		 * CRITICAL: Check if we need to adjust VTS before writing exposure.
+		 * This prevents the sensor from ignoring long exposure commands.
+		 *
+		 * mt9m114_update_vts_for_exposure() uses GROUP_HOLD internally.
+		 */
+		ret = mt9m114_update_vts_for_exposure(sensor, format, ctrl->val);
+		if (ret)
+			break;
+
+		/*
+		 * Write exposure to both registers (direct + SOC) using GROUP_HOLD
